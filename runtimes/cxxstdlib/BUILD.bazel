load("@bazel_skylib//lib:selects.bzl", "selects")
load("//runtimes:cc_runtimes.bzl", "cc_runtime_import", "cc_runtimes_toolchain")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "libcxx_linux",
    constraint_values = [
        "//constraints/cxxstdlib:libcxx",
        "@platforms//os:linux",
    ],
)

# libc++ linked dynamically, selected through the platform. A specialization
# of :libcxx_linux, so both may appear in one select. musl targets link with
# -static and cannot use it.
config_setting(
    name = "libcxx_linux_dynamic",
    constraint_values = [
        "//constraints/cxxstdlib:libcxx",
        "//constraints/cxxstdlib/linkage:dynamic",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "libcxx_windows",
    constraint_values = [
        "//constraints/cxxstdlib:libcxx",
        "@platforms//os:windows",
    ],
)

config_setting(
    name = "libcxx_windows_msvc_vcruntime",
    constraint_values = [
        "//constraints/cxxstdlib:libcxx",
        "//constraints/windows/abi:msvc",
        "@platforms//os:windows",
    ],
)

selects.config_setting_group(
    name = "libstdcxx_linux",
    match_all = [
        "//constraints/cxxstdlib:libstdcxx",
        "@platforms//os:linux",
    ],
)

# Recognize the Windows selection only to fail at the cxxstdlib routing
# boundary. The MinGW source/header entries in the libstdc++ port are audit
# parity with GCC, not supported runtime wiring yet.
selects.config_setting_group(
    name = "libstdcxx_windows",
    match_all = [
        "//constraints/cxxstdlib:libstdcxx",
        "@platforms//os:windows",
    ],
)

alias(
    name = "headers_include_search_directory",
    actual = select({
        ":libstdcxx_linux": "//runtimes/libstdcxx:headers_include_search_directory",
        ":libstdcxx_windows": ":libstdcxx_windows_unsupported",
        "//conditions:default": "@llvm-project//libcxx:libcxx_headers_include_search_directory",
    }),
)

alias(
    name = "abi_headers_include_search_directory",
    actual = select({
        ":libstdcxx_linux": "//runtimes/libstdcxx:abi_headers_include_search_directory",
        ":libstdcxx_windows": ":libstdcxx_windows_unsupported",
        # The supported native Windows tuple uses libc++ with the Microsoft
        # ABI implementation supplied by VCRuntime, not libc++abi headers.
        ":libcxx_windows_msvc_vcruntime": "@llvm//runtimes:none",
        "//conditions:default": "@llvm-project//libcxxabi:libcxxabi_headers_include_search_directory",
    }),
)

alias(
    name = "library_search_directory",
    actual = select({
        ":libstdcxx_linux": "//runtimes/libstdcxx:libstdcxx_library_search_directory",
        ":libstdcxx_windows": ":libstdcxx_windows_unsupported",
        ":libcxx_windows_msvc_vcruntime": "//runtimes/libcxx:libcxx_msvc_library_search_directory",
        "//conditions:default": "//runtimes/libcxx:libcxx_library_search_directory",
    }),
)

alias(
    name = "libstdcxx_dynamic_runtime_lib",
    actual = "//runtimes/libstdcxx:libstdcxx_shared_soname",
)

genrule(
    name = "libstdcxx_static_runtime_lib",
    outs = ["unsupported/libstdc++.a"],
    cmd = "echo 'libstdc++ is only supported as a dynamic C++ runtime; static libstdc++ is intentionally unsupported.' >&2; exit 1",
)

genrule(
    name = "libstdcxx_windows_unsupported",
    outs = ["unsupported/windows-libstdcxx"],
    # TODO(corentin): replace this with MinGW libstdc++ DLL/import-library
    # wiring once Windows libstdc++ support is intentionally added.
    cmd = "echo 'libstdc++ is currently supported only for Linux targets; Windows/MinGW libstdc++ is intentionally unsupported.' >&2; exit 1",
)

# The C++ standard library only; the unwinder is //runtimes/unwindlib.
filegroup(
    name = "static_runtime_lib",
    srcs = select({
        ":libstdcxx_linux": [":libstdcxx_static_runtime_lib"],
        ":libstdcxx_windows": [":libstdcxx_windows_unsupported"],
        ":libcxx_windows_msvc_vcruntime": ["//runtimes/libcxx:libcxx.static"],
        ":libcxx_linux": [
            "@llvm-project//libcxx:libcxx.static",
            "@llvm-project//libcxxabi:libcxxabi.static",
        ],
        ":libcxx_windows": [
            "@llvm-project//libcxx:libcxx.static",
            "@llvm-project//libcxxabi:libcxxabi.static",
        ],
        "//conditions:default": [],
    }),
)

filegroup(
    name = "dynamic_runtime_lib",
    srcs = select({
        ":libstdcxx_linux": [":libstdcxx_dynamic_runtime_lib"],
        ":libstdcxx_windows": [":libstdcxx_windows_unsupported"],
        # Windows MSVC libc++ is configuration-wide static even when ordinary
        # dependency linkage selects dynamic libraries.
        ":libcxx_windows_msvc_vcruntime": ["//runtimes/libcxx:libcxx.static"],
        ":libcxx_linux": [
            "@llvm-project//libcxx:libcxx.shared",
            "@llvm-project//libcxxabi:libcxxabi.shared",
        ],
        # TODO(zbarsky): windows?
        "//conditions:default": [],
    }),
)

# C++ runtimes toolchain (Bazel >= 9). The toolchain registered by
# //toolchain:declare_toolchains.bzl for Linux targets points here, and rules_cc
# adds the selected runtimes as dependencies of every C++ target. Each runtime
# decides its own linkage by what it provides, independently of linkstatic and
# --dynamic_mode: libstdc++ only exposes a shared library, so it is always
# linked dynamically; libc++ and libc++abi expose either static archives or
# shared libraries depending on the //constraints/cxxstdlib/linkage constraint
# of the target platform. (This toolchain does not declare
# supports_dynamic_linker on Linux, so rules_cc would pick the static archive
# of a runtime exposing both anyway.) The unwinder follows the C++ standard
# library and comes from //runtimes/unwindlib. See //runtimes:cc_runtimes.bzl.
cc_runtime_import(
    name = "libcxx_static_runtime",
    static_library = "@llvm-project//libcxx:libcxx.static",
)

cc_runtime_import(
    name = "libcxxabi_static_runtime",
    static_library = "@llvm-project//libcxxabi:libcxxabi.static",
)

cc_runtime_import(
    name = "libcxx_shared_runtime",
    shared_library = "@llvm-project//libcxx:libcxx.shared",
)

cc_runtime_import(
    name = "libcxxabi_shared_runtime",
    shared_library = "@llvm-project//libcxxabi:libcxxabi.shared",
)

cc_runtime_import(
    name = "libstdcxx_shared_runtime",
    shared_library = "//runtimes/libstdcxx:libstdcxx.shared",
)

# The C++ standard library, then the unwinder: static archives must come after
# the archives that reference them.
cc_runtimes_toolchain(
    name = "cc_runtimes",
    runtimes = select({
        ":libstdcxx_linux": [":libstdcxx_shared_runtime"],
        ":libcxx_linux_dynamic": [
            ":libcxx_shared_runtime",
            ":libcxxabi_shared_runtime",
        ],
        ":libcxx_linux": [
            ":libcxx_static_runtime",
            ":libcxxabi_static_runtime",
        ],
        "//conditions:default": [],
    }) + ["//runtimes/unwindlib:unwinder_runtime"],
)
